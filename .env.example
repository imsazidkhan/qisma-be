# ─── Runtime ─────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Browser clients (Expo Web, SPA): comma-separated origins. Leave unset to reflect any origin (OK for local dev).
# If you set this explicitly, include every dev URL your browser uses, e.g.:
#   http://localhost:8081   (Metro / Expo Web often serves here)
#   http://localhost:19006  (legacy Expo web port)
# CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Behind Fly.io / nginx / ELB: set true so req.ip / @Ip() use X-Forwarded-For (per-IP limits for contacts + OTP).
# TRUST_PROXY=true

# Optional: stable public origin for upload URLs (avatars, local receipts). If unset, URLs derive from request Host.
# PUBLIC_APP_URL=https://api.example.com

# ─── Receipt uploads (POST /v1/groups/:groupId/expenses/:expenseId/receipts) ──────────
# RECEIPT_STORAGE=local
# Optional max body size in bytes (default 10 MB, max 20 MB in schema).
# RECEIPT_MAX_BYTES=10485760
# S3-compatible (AWS S3, Cloudflare R2, MinIO). When RECEIPT_STORAGE=s3, set bucket + keys + public URL (+ endpoint for R2).
# RECEIPT_STORAGE=s3
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://your-public-bucket-origin.example.com

# ─── Database (PostgreSQL) ───────────────────────────────────
# Local:  postgresql://user:password@localhost:5432/auth_db
# Neon:   postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://auth_user:password@localhost:5432/auth_db

# ─── Redis ───────────────────────────────────────────────────
# Local:    localhost / 6379 / (empty password)
# Upstash:  your-xxx.upstash.io / 6379 / <password from dashboard>
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Set to "true" for Upstash / any managed Redis that requires TLS
REDIS_TLS=false

# ─── JWT ─────────────────────────────────────────────────────
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Minimum 32 chars. MUST be different values in production.
JWT_ACCESS_SECRET=replace-with-output-of-crypto-randomBytes-48
JWT_REFRESH_SECRET=replace-with-a-different-crypto-randomBytes-48

# Optional ISO 3166-1 alpha-2 (IN, US, …): default region for POST /v1/contacts/sync
# when uploaded numbers omit country code and your own verified phone isn’t usable to infer region.
# CONTACT_SYNC_DEFAULT_COUNTRY=IN
