# ─── Runtime ─────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database (PostgreSQL) ───────────────────────────────────
# Local:  postgresql://user:password@localhost:5432/auth_db
# Neon:   postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://auth_user:password@localhost:5432/auth_db

# ─── Redis ───────────────────────────────────────────────────
# Local:    localhost / 6379 / (empty password)
# Upstash:  your-xxx.upstash.io / 6379 / <password from dashboard>
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Set to "true" for Upstash / any managed Redis that requires TLS
REDIS_TLS=false

# ─── JWT ─────────────────────────────────────────────────────
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Minimum 32 chars. MUST be different values in production.
JWT_ACCESS_SECRET=replace-with-output-of-crypto-randomBytes-48
JWT_REFRESH_SECRET=replace-with-a-different-crypto-randomBytes-48
